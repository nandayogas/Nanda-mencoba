rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Admin = akun yang memiliki dokumen admins/{uid} di Firestore
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Hanya gambar raster yang diizinkan (SVG sengaja dilarang karena bisa membawa script)
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Folder media: publik bisa dibaca, hanya admin yang bisa upload/hapus
    match /media/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 3 * 1024 * 1024
        && isImage();
      allow delete: if isAdmin();
    }

    // Semua path lain ditolak
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
